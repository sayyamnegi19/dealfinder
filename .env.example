# --- AI providers (free tiers, no credit card) ---
# Gemini: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=your-gemini-key
# Groq:   https://console.groq.com -> API Keys
GROQ_API_KEY=your-groq-key

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres ---
DB_NAME=dealfinder
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Agent (comma-separated provider:model chain, first = primary) ---
LLM_CHAIN=google:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b

# --- MCP layer ---
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RESULTS_DEFAULT=5
# MCP_FORCE_FALLBACK=1            # use only the demo fallback server (offline dev)
# RETAIL_INTEL_PROXY=http://user:pass@proxy.example.com:8080   # optional scraping proxy
